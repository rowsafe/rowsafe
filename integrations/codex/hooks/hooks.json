{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v rowsafe >/dev/null 2>&1 || exit 0; exec rowsafe guard'",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
